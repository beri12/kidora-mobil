# Kidora mobile — PUBLIC configuration only.
# Everything prefixed EXPO_PUBLIC_ is compiled into the app and readable by
# anyone who downloads it. Never put a secret here: no DATABASE_URL, JWT
# secrets, OAuth client secrets, SMTP/Twilio/PayPal/Stripe/AI keys.

# The public Kidora API (the same one the website calls).
EXPO_PUBLIC_API_URL=https://api.justkidora.com/api
# The website, used for links (terms, privacy, social sign-in hand-off).
EXPO_PUBLIC_WEB_URL=https://justkidora.com
# Deep-link scheme; must match "scheme" in app.json.
EXPO_PUBLIC_APP_SCHEME=kidora
